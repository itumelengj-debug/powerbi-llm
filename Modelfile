$pagesPath = Join-Path $def 'pages\pages.json'
$pages = Get-Content $pagesPath -Raw -Encoding UTF8 | ConvertFrom-Json
if (@($pages.pageOrder) -notcontains $page) { $pages.pageOrder = @($pages.pageOrder) + $page }
